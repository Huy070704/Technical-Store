# ========================================
# 🗄️ DATABASE (MongoDB)
# ========================================
MONGO_URI=mongodb://localhost:27017/xxxx
# Đồng bộ index của toàn bộ model lúc khởi động (tốn nhiều round-trip tới Atlas → chậm).
# Chỉ bật khi vừa đổi schema/index; mặc định để trống/false cho boot nhanh.
SYNC_INDEXES=false


# Thời gian OTP còn hiệu lực (phút) — mặc định 10
OTP_EXPIRY_MINUTES=10

# ========================================
# 🚀 SERVER
# ========================================
PORT=3000
NODE_ENV=development

# ========================================
# 🔑 JWT
# ========================================
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# ========================================
# ☁️ CLOUDINARY (ảnh sản phẩm — Multer buffer → Cloudinary)
# ========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=G4_TechnicalStore

# ========================================
# 🌐 FRONTEND
# ========================================
FRONTEND_URL=http://localhost:5173

# ========================================
# 💳 PAYOS
# ========================================
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_RETURN_URL=http://localhost:5173/checkout/result?paymentSuccess=true
PAYOS_CANCEL_URL=http://localhost:5173/checkout/result?paymentCancelled=true

# ========================================
# ✉️ EMAIL (Nodemailer — OTP & xác nhận đơn hàng) — BẮT BUỘC để nhận OTP qua email
# ========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM="G4 Technical Store" <your_email@gmail.com>
# EMAIL_TLS_REJECT_UNAUTHORIZED=false

# ========================================
# 🌱 SEED (npm run seed — xóa DB + nạp lại từ seed-data/)
# ========================================
# Mật khẩu ghi đè khi seed (ưu tiên hơn accounts.json nếu set)
SEED_DEFAULT_PASSWORD=G4@123456
SEED_ADMIN_PASSWORD=Admin@123
SEED_CUSTOMER_PASSWORD=Customer@123
